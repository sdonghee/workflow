async def _get_category_no(page, blog_id: str, category_name: str) -> str:
    """블로그 카테고리 목록 API에서 category_name과 일치하는 categoryNo 반환.

    네이버 블로그 카테고리 API: /CategoryManage.naver?blogId=xxx
    일치 항목 없으면 '0' (미분류) 반환.
    category_name 매칭: 완전일치 → 부분일치 순서로 시도.
    """
    try:
        cat_url = f"https://blog.naver.com/CategoryManage.naver?blogId={blog_id}"
        resp = await page.evaluate("""
            async (url) => {
                try {
                    const r = await fetch(url, {credentials: 'include'});
                    return await r.text();
                } catch(e) { return ''; }
            }
        """, cat_url)

        if not resp:
            logger.warning("[category] API 응답 없음 → categoryNo=0 사용")
            return "0"

        # JSON 파싱 시도
        import json as _json
        try:
            data = _json.loads(resp)
            cats = data if isinstance(data, list) else data.get("categories", data.get("categoryList", []))
        except Exception:
            # HTML 응답이면 정규식으로 추출
            import re as _re3
            cats = [
                {"categoryNo": m.group(1), "categoryName": m.group(2)}
                for m in _re3.finditer(r'"categoryNo"\s*:\s*"?(\d+)"?,\s*"categoryName"\s*:\s*"([^"]+)"', resp)
            ]

        if not cats:
            logger.warning("[category] 카테고리 목록 비어있음 → categoryNo=0")
            return "0"

        # 완전 일치 우선
        for cat in cats:
            name = cat.get("categoryName", cat.get("name", ""))
            if name == category_name:
                no = str(cat.get("categoryNo", cat.get("no", "0")))
                logger.info(f"[category] 완전 일치: '{name}' → categoryNo={no}")
                return no

        # 부분 일치
        category_lower = category_name.lower().replace("_", " ").replace("/", " ")
        for cat in cats:
            name = cat.get("categoryName", cat.get("name", ""))
            name_lower = name.lower()
            if category_lower in name_lower or name_lower in category_lower:
                no = str(cat.get("categoryNo", cat.get("no", "0")))
                logger.info(f"[category] 부분 일치: '{name}' → categoryNo={no}")
                return no

        logger.warning(f"[category] '{category_name}' 매칭 실패 → categoryNo=0 (미분류)")
        return "0"

    except Exception as e:
        logger.warning(f"[category] 조회 실패: {e} → categoryNo=0")
        return "0"


async def _verify_posted(page, blog_id: str, title: str, log_no: str | None = None) -> bool:
    """
    Verify that the newly published post is actually visible on Naver blog.
    Strict mode: no fallback based on "recent post count".
    """
    try:
        # 1) If logNo is known, verify direct post URL first (most reliable).
        if log_no:
            direct_url = f"https://blog.naver.com/{blog_id}/{log_no}"
            logger.info(f"Direct URL verify: {direct_url}")
            await page.goto(direct_url, wait_until="domcontentloaded", timeout=30000)
            await page.wait_for_timeout(3000)
            direct_content = await page.content()
            if title in direct_content:
                logger.info(f"✅ Direct URL verification succeeded: {title}")
                return True

        # 2) Current page must be a real PostView URL to count as success.
        current_url = page.url
        if "PostView.naver" in current_url:
            logger.info(f"✅ PostView redirect confirmed: {current_url}")
            return True

        # 3) Open blog home and check exact title in mainFrame/page source.
        blog_url = f"https://blog.naver.com/{blog_id}"
        logger.info(f"Blog verification start: {blog_url}")
        await page.goto(blog_url, wait_until="domcontentloaded", timeout=30000)
        await page.wait_for_timeout(4000)

        # 블로그 홈 스크린샷 (디버깅)
        await _screenshot(page, "verify_blog_home", blog_id)

        main_frame = page.frame(name="mainFrame")
        if main_frame:
            try:
                await main_frame.wait_for_load_state("domcontentloaded", timeout=8000)
            except Exception:
                pass
            iframe_content = await main_frame.content()
            if title in iframe_content:
                logger.info(f"✅ mainFrame title match: {title}")
                return True

        content = await page.content()
        if title in content:
            logger.info(f"✅ page source title match: {title}")
            return True

        logger.warning(f"⚠️ posted-title not found on blog: {title}")
        return False

    except Exception as e:
        logger.error(f"Blog verification error: {e}")
        return False


def _ensure_xvfb() -> bool:
    """Xvfb 가상 X11 디스플레이 시작 (없으면 headless 유지)

    SmartEditor ONE은 실제 시스템 클립보드 Ctrl+V만 허용.
    Docker headless 환경에서는 X11 디스플레이 없이 xclip 불가 → Xvfb로 해결.
    """
    global _xvfb_proc
    if os.environ.get("DISPLAY"):
        logger.info(f"DISPLAY 이미 설정: {os.environ['DISPLAY']}")
        return True
    try:
        _xvfb_proc = subprocess.Popen(
            ["Xvfb", ":99", "-screen", "0", "1280x800x24", "-nolisten", "tcp"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        os.environ["DISPLAY"] = ":99"
        time.sleep(1.5)  # Xvfb 초기화 대기
        logger.info("✅ Xvfb :99 시작 → DISPLAY=:99 (비headless 모드로 전환)")
        return True
    except FileNotFoundError:
        logger.warning("Xvfb 없음 → headless 모드 유지 (클립보드 제한)")
        return False
    except Exception as e:
        logger.warning(f"Xvfb 시작 실패: {e}")
        return False


def _build_cf_html(html_fragment: str) -> bytes:
    """Windows CF_HTML 클립보드 포맷 빌더.

    SmartEditor ONE은 Windows CF_HTML 포맷의 HTML 클립보드를 인식함.
    바이트 오프셋이 정확해야 하므로 UTF-8 인코딩 후 계산.
    """
    HEADER = (
        "Version:0.9\r\n"
        "StartHTML:{start_html:010d}\r\n"
        "EndHTML:{end_html:010d}\r\n"
        "StartFragment:{start_frag:010d}\r\n"
        "EndFragment:{end_frag:010d}\r\n"
    )
    PRE  = "<html><body>\r\n<!--StartFragment-->"
    POST = "<!--EndFragment-->\r\n</body></html>"

    # 더미 헤더로 헤더 바이트 길이 계산
    dummy = HEADER.format(start_html=0, end_html=0, start_frag=0, end_frag=0)
    header_len  = len(dummy.encode("utf-8"))
    pre_bytes   = PRE.encode("utf-8")
    frag_bytes  = html_fragment.encode("utf-8")
    post_bytes  = POST.encode("utf-8")

    start_html  = header_len
    start_frag  = header_len + len(pre_bytes)
    end_frag    = start_frag + len(frag_bytes)
    end_html    = end_frag   + len(post_bytes)

    header = HEADER.format(
        start_html=start_html, end_html=end_html,
        start_frag=start_frag, end_frag=end_frag,
    )
    return header.encode("utf-8") + pre_bytes + frag_bytes + post_bytes


def _xclip_write(html: str) -> bool:
    """HTML을 X11 클립보드에 씀 (xclip 사용)

    xclip은 다른 프로세스가 클립보드를 요청할 때까지 실행 유지 (데몬 방식).
    subprocess.run()으로 기다리면 타임아웃 → Popen()으로 백그라운드 실행해야 함.
    """
    if not os.environ.get("DISPLAY"):
        return False
    try:
        # Popen: stdin으로 데이터 전달 후 백그라운드에서 대기
        # xclip은 Ctrl+V(clipboard 요청)를 받으면 데이터 제공 후 종료
        proc = subprocess.Popen(
            ["xclip", "-selection", "clipboard", "-t", "text/html"],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        proc.stdin.write(html.encode("utf-8"))
        proc.stdin.close()
        # 완료 대기 없음 - xclip이 클립보드 요청을 받을 때까지 실행 유지
        time.sleep(0.3)  # xclip 클립보드 소유권 등록 대기
        logger.info(f"xclip text/html 백그라운드 실행 ({len(html):,} bytes)")
        return True
    except FileNotFoundError:
        logger.warning("xclip 없음")
        return False
    except Exception as e:
        logger.warning(f"xclip 예외: {e}")
        return False


