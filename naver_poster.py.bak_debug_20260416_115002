                        params.append('cclUploadLicense',    '');
                        params.append('cclCommercial',       '');
                        params.append('cclModification',     '');
                        return params;
                    };

                    const commonHeaders = {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest',
                        'Referer': referer || window.location.href,
                        'Origin': 'https://blog.naver.com',
                    };

                    // 시도할 엔드포인트 목록 (우선순위 순)
                    const endpoints = [
                        'https://blog.naver.com/PostSaveAjax.naver',
                        'https://blog.naver.com/api/blogs/' + blogId + '/post-write/posts',
