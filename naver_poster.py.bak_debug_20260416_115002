async def _verify_posted(page, blog_id: str, title: str, log_no: str | None = None) -> bool:
    """
    Verify that the newly published post is actually visible on Naver blog.
    Strict mode: no fallback based on "recent post count".
    """
    try:
        # 1) If logNo is known, verify direct post URL first (most reliable).
        if log_no:
            direct_url = f"https://blog.naver.com/{blog_id}/{log_no}"
            logger.info(f"Direct URL verify: {direct_url}")
            await page.goto(direct_url, wait_until="domcontentloaded", timeout=30000)
            await page.wait_for_timeout(3000)
            direct_content = await page.content()
            if title in direct_content:
                logger.info(f"✅ Direct URL verification succeeded: {title}")
                return True

        # 2) Current page must be a real PostView URL to count as success.
        current_url = page.url
        if "PostView.naver" in current_url:
            logger.info(f"✅ PostView redirect confirmed: {current_url}")
            return True

        # 3) Open blog home and check exact title in mainFrame/page source.
        blog_url = f"https://blog.naver.com/{blog_id}"
        logger.info(f"Blog verification start: {blog_url}")
        await page.goto(blog_url, wait_until="domcontentloaded", timeout=30000)
        await page.wait_for_timeout(4000)

        main_frame = page.frame(name="mainFrame")
        if main_frame:
            try:
                await main_frame.wait_for_load_state("domcontentloaded", timeout=8000)
            except Exception:
                pass
            iframe_content = await main_frame.content()
            if title in iframe_content:
                logger.info(f"✅ mainFrame title match: {title}")
                return True

        content = await page.content()
        if title in content:
            logger.info(f"✅ page source title match: {title}")
            return True

        logger.warning(f"⚠️ posted-title not found on blog: {title}")
        return False

    except Exception as e:
        logger.error(f"Blog verification error: {e}")
        return False

async def _dismiss_draft_popup(frame, page=None):
    """'작성 중인 글이 있습니다' HTML 팝업 처리.

    새 글을 발행할 것이므로 임시저장 초안은 버리고 '새 글 쓰기'를 선택.
    '새 글 쓰기' 버튼이 없으면 '취소' → '닫기' 순으로 시도.
    frame=None 이면 page 컨텍스트에서만 시도.
    """
    _POPUP_JS = """
        () => {
            var LABELS_DISCARD = ['새 글 쓰기', '새글 쓰기', '새 글쓰기', '취소', '닫기'];
            var btns = Array.from(document.querySelectorAll('button'));
            for (var label of LABELS_DISCARD) {
                var btn = btns.find(b => b.textContent.trim() === label
                    && b.offsetParent !== null);
                if (btn) { btn.click(); return 'dismissed:' + label; }
            }
            return 'no_popup';
        }
    """
    contexts = []
    if frame:
        contexts.append(("frame", frame))
    if page:
        contexts.append(("page", page))

    for ctx_name, ctx in contexts:
        try:
            result = await ctx.evaluate(_POPUP_JS)
            if result.startswith('dismissed'):
                logger.info(f"작성 중인 글 팝업 처리 ({ctx_name}): {result}")
                return
        except Exception:
            pass


async def _enter_title(frame, page, title):
    """제목 입력 (frame 컨텍스트에서 실행, frame=None이면 page 직접 사용)"""
    ctx = frame if frame else page  # 새 SmartEditor: iframe 없이 page에서 직접 탐색

    selectors = [
        '.se-title-text', '.se-title-input',
        'div[contenteditable="true"][class*="title"]'
    ]
    for sel in selectors:
        try:
            locator = ctx.locator(sel).first
            if await locator.count() > 0:
                await locator.click(timeout=5000)
                await page.keyboard.press("Control+a")
                await page.keyboard.type(title, delay=50)
                logger.info(f"제목 입력 완료: {title[:30]} (selector: {sel})")
                return
        except Exception:
            continue
    logger.error("모든 selector로 제목 입력 실패. 스크린샷을 확인하세요.")


async def _enter_content(frame, page, content_html):
    """본문 입력 (frame 컨텍스트에서 실행, frame=None이면 page 직접 사용)

    시도 순서:
    -1. SmartEditor JS API setContents() 직접 주입 (서식 보존 최우선)
     0. win32clipboard CF_HTML (Windows + pywin32)
     1. xclip + Ctrl+V (Linux X11/Xvfb)
     2. keyboard.type — HTML 태그 strip 후 plain text 입력 (서식 손실)
     3. navigator.clipboard + Ctrl+V
     4. pyperclip plain text
    """
    ctx = frame if frame else page

    try:
        body_selector = '.se-placeholder, .se-component:not(.se-component-title)'
        await ctx.locator(body_selector).first.click(timeout=10000, force=True)
        logger.info(f"본문 영역 클릭 완료: {body_selector}")
        await page.wait_for_timeout(500)
    except Exception:
        logger.warning("본문 영역 클릭 실패, 계속 진행")

    paste_success = False

    # 에디터 본문 영역 텍스트 길이 확인 JS
    # title 클래스가 없는 contenteditable 요소의 텍스트 합산
    _EDITOR_LEN_JS = """
        () => {
            var eds = Array.from(document.querySelectorAll('[contenteditable="true"]'));
            var total = 0;
            for (var ed of eds) {
                if (ed.contentEditable !== 'true') continue;
                var cls = (ed.className || '').toLowerCase();
                // 제목 입력 영역 제외
                if (cls.includes('title')) continue;
                // data-placeholder 가 제목 관련이면 제외
                var ph = (ed.getAttribute('data-placeholder') || '').toLowerCase();
                if (ph.includes('제목') || ph.includes('title')) continue;
                total += ed.innerText.trim().length;
            }
            return total;
        }
    """

    # ── 방법 -1: SmartEditor JS API 직접 주입 (1순위) ──────────────
    # SmartEditor ONE은 내부 인스턴스에 setContents() API를 노출하는 경우가 있음.
    # HTML을 클립보드 없이 직접 주입 → 서식(굵게/표/링크) 보존 가능.
    if not paste_success:
        try:
            result = await ctx.evaluate("""
                (html) => {
                    // SmartEditor ONE 인스턴스 탐색 (전역 변수 또는 DOM 기반)
                    var editor =
                        window.se2 ||
                        window.__smartEditor ||
                        window.smartEditor ||
                        (window.nhn && window.nhn.husky && window.nhn.husky.SmartEditor2 &&
                         window.nhn.husky.SmartEditor2.getInstance &&
                         window.nhn.husky.SmartEditor2.getInstance('ir1')) ||
                        null;

                    // 전역 탐색으로 찾지 못한 경우 window 속성 순회
                    if (!editor) {
                        for (var key in window) {
                            try {
                                var v = window[key];
                                if (v && typeof v === 'object' && typeof v.setContents === 'function') {
                                    editor = v;
                                    break;
                                }
                            } catch(e) {}
                        }
                    }

                    if (!editor || typeof editor.setContents !== 'function') {
                        return 'no_api';
                    }
                    editor.setContents(html);
                    return 'ok';
                }
            """, content_html)

            if result == 'ok':
                await page.wait_for_timeout(1000)
                ed_len = await ctx.evaluate(_EDITOR_LEN_JS)
                if ed_len > 10:
                    logger.info(f"✅ 본문 입력 완료 (SmartEditor JS API, {ed_len}자)")
                    paste_success = True
                else:
                    logger.warning(f"SmartEditor JS API 호출 후 에디터 {ed_len}자 → 다음 방법 시도")
            else:
                logger.info(f"SmartEditor JS API 미노출 ({result}) → 다음 방법 시도")
        except Exception as e:
            logger.warning(f"SmartEditor JS API 방식 실패: {e}")

    # ── 방법 0: win32clipboard CF_HTML (Windows 전용) ────────────
    if not paste_success and sys.platform == "win32":
        try:
            import win32clipboard
            cf_html_data = _build_cf_html(content_html)
            CF_HTML = win32clipboard.RegisterClipboardFormat("HTML Format")
            win32clipboard.OpenClipboard(0)
            win32clipboard.EmptyClipboard()
            win32clipboard.SetClipboardData(CF_HTML, cf_html_data)
            win32clipboard.CloseClipboard()
            await page.keyboard.press("Control+V")
            await page.wait_for_timeout(2500)
            ed_len = await ctx.evaluate(_EDITOR_LEN_JS)
            if ed_len > 30:
                logger.info(f"✅ 본문 입력 완료 (win32clipboard CF_HTML, {ed_len}자)")
                paste_success = True
            else:
                logger.warning(f"win32clipboard CF_HTML 후 에디터 {ed_len}자 → 다음 방법 시도")
        except ImportError:
            logger.info("win32clipboard(pywin32) 없음 → 다음 방법 시도")
        except Exception as e:
            logger.warning(f"win32clipboard 방식 실패: {e}")

    # ── 방법 1: xclip (Linux/Xvfb) ──────────────────────────────
    if not paste_success and bool(os.environ.get("DISPLAY")) and _xclip_write(content_html):
        try:
            await page.keyboard.press("Control+V")
            await page.wait_for_timeout(2500)
            ed_len = await ctx.evaluate(_EDITOR_LEN_JS)
            if ed_len > 30:
                logger.info(f"✅ 본문 입력 완료 (xclip + Ctrl+V 방식, {ed_len}자)")
                paste_success = True
            else:
                logger.warning(f"xclip Ctrl+V 후 에디터 {ed_len}자")
        except Exception as e:
            logger.warning(f"xclip Ctrl+V 실패: {e}")

    # ── 방법 2: keyboard.type (SmartEditor React 상태 직접 업데이트) ─
    # navigator.clipboard/execCommand 는 DOM만 수정 → React 상태 미반영 → 발행 시 빈 글
    # keyboard.type 는 실제 key event → SmartEditor React 상태 반영 → 발행 성공 확인됨
    if not paste_success:
        try:
            import re as _re_t
            plain = content_html.replace("<br>", "\n").replace("<br/>", "\n").replace("<br />", "\n")
            plain = _re_t.sub(r'<[^>]+>', '', plain).strip()

            # Playwright locator 클릭으로 SmartEditor 본문 포커스 (JS 클릭은 이벤트 핸들러 미발동)
            # .se-placeholder → 빈 편집 상태, 클릭 시 SmartEditor가 contenteditable 생성
            body_clicked = False
            for body_sel in ['.se-placeholder', '.se-component:not(.se-component-title)']:
                try:
                    loc = ctx.locator(body_sel).first
                    if await loc.count() > 0:
                        await loc.click(timeout=3000)
                        await page.wait_for_timeout(600)  # SmartEditor 반응 대기
                        body_clicked = True
                        logger.info(f"keyboard.type: 본문 클릭 ({body_sel})")
                        break
                except Exception:
                    pass
            if not body_clicked:
                # 좌표 클릭 폴백 (에디터 중앙부)
                await page.mouse.click(640, 400)
                await page.wait_for_timeout(600)
                logger.info("keyboard.type: 좌표 클릭 (640, 400)")

            # 최대 3000자 타이핑 (5ms/자 → 약 15초)
            await page.keyboard.type(plain[:3000], delay=5)
            await page.wait_for_timeout(800)

            # 성공 확인: 플레이스홀더 사라짐 = 컨텐츠 입력됨
            placeholder_gone = await ctx.evaluate("""
                () => {
                    var ph = document.querySelector('.se-placeholder');
                    return !ph || ph.style.display === 'none' || ph.offsetParent === null;
                }
            """)
            ed_len = await ctx.evaluate(_EDITOR_LEN_JS)
            body_len = await ctx.evaluate("document.body.innerText.trim().length")
            logger.info(f"keyboard.type 후: placeholder_gone={placeholder_gone}, ed_len={ed_len}, body_len={body_len}")

            if placeholder_gone or ed_len > 30 or body_len > 500:
                logger.info(f"✅ 본문 입력 완료 (keyboard.type, ed={ed_len}자, body={body_len}자)")
                paste_success = True
            else:
                logger.warning(f"keyboard.type 후 에디터 {ed_len}자, body {body_len}자, placeholder_gone={placeholder_gone}")
        except Exception as e:
            logger.error(f"keyboard.type 방식 실패: {e}")

    # ── 방법 3: navigator.clipboard API (HTML 붙여넣기) ─────────
    if not paste_success:
        try:
            await page.context.grant_permissions(["clipboard-read", "clipboard-write"])
            await ctx.evaluate("""async (html) => {
                const htmlBlob = new Blob([html], {type: 'text/html'});
                const textBlob = new Blob([html.replace(/<[^>]+>/g, ' ')], {type: 'text/plain'});
                await navigator.clipboard.write([new ClipboardItem({'text/html': htmlBlob, 'text/plain': textBlob})]);
            }""", content_html)
            await page.keyboard.press("Control+V")
            await page.wait_for_timeout(2500)
            ed_len = await ctx.evaluate(_EDITOR_LEN_JS)
            if ed_len > 30:
                logger.info(f"✅ 본문 입력 완료 (navigator.clipboard + Ctrl+V, {ed_len}자)")
                paste_success = True
            else:
                logger.warning(f"navigator.clipboard + Ctrl+V 후 에디터 {ed_len}자")
        except Exception as e:
            logger.warning(f"navigator.clipboard 방식 실패: {e}")

    # ── 방법 4: pyperclip (Windows 네이티브 클립보드, plain text) ─
    if not paste_success:
        try:
            import pyperclip
            import re as _re2
            plain2 = content_html.replace("<br>", "\n").replace("<br/>", "\n").replace("<br />", "\n")
            plain2 = _re2.sub(r'<[^>]+>', '', plain2)
            pyperclip.copy(plain2)
            await page.keyboard.press("Control+V")
            await page.wait_for_timeout(2500)
            ed_len = await ctx.evaluate(_EDITOR_LEN_JS)
            if ed_len > 30:
                logger.info(f"✅ 본문 입력 완료 (pyperclip + Ctrl+V, plain text, {ed_len}자)")
                paste_success = True
            else:
                logger.warning(f"pyperclip Ctrl+V 후 에디터 {ed_len}자")
        except ImportError:
            logger.warning("pyperclip 없음 → 다음 방법 시도")
        except Exception as e:
            logger.warning(f"pyperclip 방식 실패: {e}")

    return paste_success


async def _publish(page, run_id: str = "", category: str = ""):
    """
    발행 흐름:
      1) JS evaluate로 헤더 '발행' 버튼 클릭 (패널 열기)
      1.5) 발행 패널에서 카테고리 선택 (category 인수가 있을 때)
      2) confirm_btn__* 로케이터로 확인 버튼 click(force=True)
         force=True → pointer-events 오버레이(도움말 패널 등) 우회
      3) JS evaluate 폴백 (React synthetic event dispatch)
    """

    # ── POST 요청 캡처 리스너 (발행 전에 등록) ──────────────────────
    _captured_posts: list = []

    def _on_request(request):
        if request.method == "POST":
            try:
                payload = request.post_data or ""
            except Exception:
                payload = "(payload 읽기 실패)"
            _captured_posts.append({"url": request.url, "payload": payload[:500]})
            logger.info(f"[POST 캡처] {request.url}\n  payload: {payload[:500]}")

    page.on("request", _on_request)

    # ── Step 1. 헤더 '발행' 버튼 JS 클릭 (패널 열기) ────────────────
    # 본문 입력 후 스크롤이 내려가 있을 수 있으므로 맨 위로 스크롤
    await page.evaluate("window.scrollTo(0, 0)")
    await page.wait_for_timeout(500)

    # publish_btn__* (70x30) 을 우선 탐색, 없으면 텍스트 기반
    open_result = await page.evaluate("""
        () => {
            // publish_btn_area(컨테이너)를 제외하고 실제 버튼만 탐색
            // publish_btn__m9KHH 같은 실제 <button> 태그 우선
            var btn = Array.from(document.querySelectorAll('button[class*="publish_btn"]'))
                .find(b => !b.className.includes('publish_btn_area')
                        && b.getBoundingClientRect().width > 0);
            if (!btn) {
                btn = Array.from(document.querySelectorAll('button'))
                    .find(b => b.textContent.trim() === '발행' &&
                               b.getBoundingClientRect().width > 0);
            }
            if (btn) { btn.click(); return btn.className; }
            return null;
        }
    """)
    if not open_result:
        logger.error("'발행' 헤더 버튼을 DOM에서 찾지 못했습니다.")
        await _screenshot(page, "error_publish_btn1_notfound", run_id)
        return False

    logger.info(f"'발행' 헤더 버튼 JS 클릭 (패널 열기): {open_result[:60]}")
    await page.wait_for_timeout(500)  # 패널 애니메이션 시작 대기
    # 패널 열림을 confirm 버튼 출현으로 확인 (최대 5초)
    try:
        await page.wait_for_selector(
            '[class*="confirm_btn"], [class*="confirmBtn"], [class*="publish_confirm"]',
            timeout=5000
        )
        logger.info("[publish] 발행 패널 열림 확인 (confirm 버튼 감지)")
    except Exception:
        logger.warning("[publish] 발행 패널 confirm 버튼 대기 타임아웃 → 고정 2초 대기")
        await page.wait_for_timeout(2000)
    await _screenshot(page, "04_after_publish_click", run_id)

    # ── Step 1.5. 발행 패널 내 버튼 목록 로깅 (디버깅) + 카테고리 선택 ──
    panel_debug = await page.evaluate("""
        () => {
            var btns = Array.from(document.querySelectorAll('button'));
            return btns
                .filter(b => b.getBoundingClientRect().width > 0)
                .map(b => ({
                    text: b.textContent.trim().substring(0, 20),
                    cls: b.className.substring(0, 60),
                    inHeaderArea: !!b.closest('[class*="publish_btn_area"]'),
                }));
        }
    """)
    logger.info(f"[발행 패널] 현재 가시 버튼 목록: {panel_debug}")

    if category:
        try:
            cat_result = await page.evaluate("""
                (categoryName) => {
                    var selects = Array.from(document.querySelectorAll('select'));
                    for (var sel of selects) {
                        var opts = Array.from(sel.options);
                        var opt = opts.find(o => o.text.trim() === categoryName);
                        if (!opt) {
                            var lower = categoryName.toLowerCase().split('_').join(' ').split('/').join(' ');
                            opt = opts.find(o => o.text.toLowerCase().includes(lower)
                                             || lower.includes(o.text.toLowerCase()));
                        }
                        if (opt) {
                            sel.value = opt.value;
                            sel.dispatchEvent(new Event('change', {bubbles: true}));
                            return 'selected:' + opt.text + '=' + opt.value;
                        }
                    }
                    var items = Array.from(document.querySelectorAll(
                        '[class*="category"] li, [class*="category"] button, [class*="Category"] li'));
                    var lower2 = categoryName.toLowerCase().split('_').join(' ').split('/').join(' ');
                    for (var item of items) {
                        var text = item.textContent.trim();
                        if (text === categoryName || text.toLowerCase().includes(lower2)) {
                            item.click();
                            return 'clicked:' + text;
                        }
                    }
                    return 'not_found';
                }
            """, category)
            if cat_result.startswith(('selected:', 'clicked:')):
                logger.info(f"[발행 패널] 카테고리 선택: {cat_result}")
                await page.wait_for_timeout(500)
            else:
                logger.warning(f"[발행 패널] 카테고리 '{category}' 선택 실패: {cat_result}")
        except Exception as e:
            logger.warning(f"[발행 패널] 카테고리 선택 예외: {e}")

    # ── Step 2. 발행 확인 버튼 클릭 ─────────────────────────────────
    # 구조: publish_btn_area > publish_btn (패널열기) + confirm_btn (발행확인)
    # publish_btn__m9KHH 는 제외, confirm_btn__WEaBq 는 클릭해야 함

    # 도움말 패널이 confirm 버튼 위를 덮어 클릭을 막으므로 먼저 제거
    try:
        removed = await page.evaluate("""
            () => {
                // container__HW_tc (도움말 컨테이너) 숨기기
                var help = document.querySelector('[class*="container__HW"]');
                if (help) { help.style.display = 'none'; return 'removed'; }
                // 도움말 닫기 버튼 클릭
                var closeBtn = document.querySelector('.help_close, [aria-label="닫기"]');
                if (closeBtn) { closeBtn.click(); return 'closed'; }
                return 'no_help';
            }
        """)
        logger.info(f"[confirm] 도움말 패널 처리: {removed}")
        await page.wait_for_timeout(300)
    except Exception as e:
        logger.debug(f"[confirm] 도움말 패널 처리 예외: {e}")

    confirm_clicked = False

    # 2-A: confirm_btn 클래스 직접 클릭 (publish_btn 클래스는 제외)
    confirm_selectors = [
        '[class*="confirm_btn"]',
        '[class*="confirmBtn"]',
        '[class*="publish_confirm"]',
        '[class*="publishConfirm"]',
        '[class*="btn_publish"]',
        '[class*="btnPublish"]',
    ]
    for sel in confirm_selectors:
        try:
            loc = page.locator(sel).first
            if await loc.count() > 0:
                cls = await loc.get_attribute("class") or ""
                # 패널 열기 버튼(publish_btn__*)은 제외, confirm_btn__*은 허용
                if "publish_btn__" in cls and "confirm" not in cls:
                    logger.debug(f"[confirm] 헤더 발행 버튼 건너뜀: {cls[:40]}")
                    continue
                # scroll into view 후 실제 클릭 (force=True는 React 이벤트 못 유발)
                await loc.scroll_into_view_if_needed()
                await page.wait_for_timeout(300)
                await loc.click(timeout=5000)
                logger.info(f"[confirm] Playwright 실제 클릭: {cls[:60]}")
                confirm_clicked = True
                break
        except Exception as e:
            logger.debug(f"confirm selector 실패 ({sel}): {e}")

    # 2-B: JS로 패널 안의 '발행' 버튼 탐색 (헤더 버튼 명시적 제외)
    if not confirm_clicked:
        logger.warning("[confirm] locator 실패 → JS .click() 직접 호출")
        # confirm_btn__WEaBq 처럼 publish_btn__ 가 아닌 버튼을 .click() 으로 직접 호출
        fallback = await page.evaluate("""
            () => {
                var btns = Array.from(document.querySelectorAll('button'));
                // publish_btn__ (패널 열기 버튼)은 제외, confirm_btn__ 는 허용
                var btn = btns.find(b => {
                    var cls = b.className;
                    var r = b.getBoundingClientRect();
                    return r.width > 0 && r.height > 0
                        && (cls.includes('confirm_btn') || cls.includes('confirmBtn'))
                        && !cls.includes('publish_btn__');
                });
                if (!btn) {
                    // publish_btn__ 제외 + 텍스트 '발행' + 크기 조건
                    btn = btns.find(b => {
                        var r = b.getBoundingClientRect();
                        return b.textContent.trim() === '발행'
                            && !b.className.includes('publish_btn__')
                            && !b.className.includes('fold')
                            && r.width >= 30 && r.height >= 20;
                    });
                }
                if (btn) {
                    btn.click();  // dispatchEvent 대신 실제 .click() 호출
                    return btn.className;
                }
                return null;
            }
        """)
        if fallback:
            logger.info(f"[confirm] JS .click() 호출: {fallback[:80]}")
            confirm_clicked = True

    # 2-C: 키보드 Enter (패널이 열려 있을 때 Enter 키로 확인)
    if not confirm_clicked:
        logger.warning("[confirm] JS 탐색 실패 → 키보드 Enter 시도")
        try:
            await page.keyboard.press("Enter")
            confirm_clicked = True
            logger.info("[confirm] 키보드 Enter 전송")
        except Exception as e:
            logger.warning(f"[confirm] Enter 실패: {e}")

    # ── PostView 리다이렉트 또는 RabbitWrite 응답 대기 (최대 25초) ──
    # 확인 버튼 클릭 후 Naver SmartEditor는:
    #   RabbitAutoSaveWrite.naver → RabbitWrite.naver → PostView.naver?isAfterWrite=true
    # 순서로 진행함. URL 변화나 POST 캡처로 성공 확인.
    try:
        await page.wait_for_url("**/PostView.naver**", timeout=25000)
        logger.info(f"✅ PostView 리다이렉트 완료: {page.url}")
    except Exception:
        # PostView로 이동하지 않은 경우 — POST 캡처 결과로 판단
        logger.info("PostView 리다이렉트 없음 (25초 초과) → POST 캡처 내역 확인")
        await page.wait_for_timeout(2000)

    # ── 리스너 해제 + 캡처 요약 ────────────────────────────────────
    page.remove_listener("request", _on_request)
    if _captured_posts:
        logger.info(f"[POST 캡처 요약] 발행 후 POST {len(_captured_posts)}건:")
        for i, r in enumerate(_captured_posts, 1):
            logger.info(f"  [{i}] {r['url']}")
            logger.info(f"       payload: {r['payload'][:300]}")
    else:
        logger.warning("[POST 캡처] 발행 후 POST 요청 없음 → 확인 버튼 미작동")

    await _screenshot(page, "05_after_final_publish", run_id)

    # RabbitWrite.naver 캡처되거나 PostView URL이면 성공
    rabbit_ok = any("RabbitWrite" in p["url"] for p in _captured_posts)
    postview_ok = "PostView" in page.url
    if rabbit_ok:
        logger.info("✅ RabbitWrite.naver POST 캡처 → 발행 성공")
        return True
    if postview_ok:
        logger.info("✅ PostView URL 확인 → 발행 성공")
        return True
    if confirm_clicked:
        logger.warning("확인 버튼 클릭했으나 RabbitWrite 미캡처 — 외부에서 재확인 필요")
        return True  # 외부 _verify_posted 에서 최종 판단
    return False


# ─────────────────────────────────────────
# HTTP API 폴백 (브라우저 없이 requests 사용)
# ─────────────────────────────────────────

def _cookies_to_requests(playwright_cookies):
    """Playwright 쿠키 리스트 → requests CookieJar 호환 dict"""
    return {c["name"]: c["value"] for c in playwright_cookies if "name" in c and "value" in c}


def post_via_http(title, content_html, tags, category, blog_config) -> bool:
    """
    브라우저 없이 requests로 Naver Blog AJAX API 직접 호출.
    저장된 쿠키가 유효해야 동작 (만료 시 False 반환).
    """
    import requests as req

    cookie_data = load_cookies(blog_config["cookie_file"])
    if not cookie_data:
        logger.error("[HTTP] 저장된 쿠키 없음 — first_login.py 실행 필요")
        return False

    blog_id  = blog_config["blog_id"]
    naver_id = blog_config["naver_id"]

    session = req.Session()
    session.headers.update({
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
        "Accept-Language": "ko-KR,ko;q=0.9",
        "Referer": f"https://blog.naver.com/PostWriteForm.naver?blogId={blog_id}",
        "X-Requested-With": "XMLHttpRequest",
        "Origin": "https://blog.naver.com",
    })
    session.cookies.update(_cookies_to_requests(cookie_data))

    # 로그인 상태 확인
    try:
        check = session.get("https://www.naver.com", timeout=10)
        if naver_id.lower() not in check.text.lower() and "로그아웃" not in check.text:
            logger.error("[HTTP] 쿠키 만료 — first_login.py 로 재로그인 필요")
            return False
    except Exception as e:
        logger.error(f"[HTTP] 로그인 확인 실패: {e}")
        return False

    # 글쓰기 폼 GET → 숨겨진 토큰 추출
    try:
        form_resp = session.get(
            f"https://blog.naver.com/PostWriteForm.naver?blogId={blog_id}",
            timeout=15,
        )
    except Exception as e:
        logger.error(f"[HTTP] 글쓰기 폼 로드 실패: {e}")
        return False

    # CSRF / blogNo 파싱 시도
    blog_no = ""
    import re
    m = re.search(r'"blogNo"\s*:\s*"?(\d+)"?', form_resp.text)
    if m:
        blog_no = m.group(1)

    # 포스팅 AJAX 요청
    post_data = {
        "blogId":              blog_id,
        "blogNo":              blog_no,
        "logNo":               "0",
        "title":               title,
        "contents":            content_html,
        "categoryNo":          "0",
        "tag":                 tags,
        "type":                "post",
        "status":              "publish",
        "useRssYN":            "Y",
        "allowComment":        "true",
        "allowLike":           "true",
        "allowExternalSearch": "true",
        "addCategoryYN":       "N",
        "addContents":         "",
        "publishDate":         "",
        "publishTime":         "",
        "cclUploadLicense":    "",
        "cclCommercial":       "",
        "cclModification":     "",
    }

    try:
        resp = session.post(
            "https://blog.naver.com/PostSaveAjax.naver",
            data=post_data,
            timeout=30,
        )
        logger.info(f"[HTTP] 응답 {resp.status_code}: {resp.text[:300]}")
        try:
            j = resp.json()
            if j.get("result") == "SUCCESS" or j.get("logNo") or j.get("postNo"):
                logger.info(f"[HTTP] ✅ 포스팅 성공: {j}")
                return True
            logger.error(f"[HTTP] API 오류 응답: {j}")
        except Exception:
            # JSON이 아닌 경우 200이면 성공으로 간주
            if resp.status_code == 200 and "error" not in resp.text.lower():
                logger.info("[HTTP] ✅ 포스팅 성공 (비JSON 200 응답)")
                return True
        return False
    except Exception as e:
        logger.error(f"[HTTP] POST 실패: {e}")
        return False


