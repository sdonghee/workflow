def post_blog(title, content_html, tags, category, blog_config):
    """브라우저 시도 → HTTP API 폴백 → False"""
    # 브라우저 시도
    try:
        return asyncio.run(post_to_naver_blog(title, content_html, tags, category, blog_config))
    except BrowserUnavailableError:
        logger.warning("[post_blog] 브라우저 불가 → HTTP API 폴백")
        return post_via_http(title, content_html, tags, category, blog_config)


def save_post_locally(title, content_html, tags, category, blog_config, filename=None, sections=None):
    """
    [수정] 포스트를 로컬 JSON 파일로 저장. 파일명은 ASCII로만 구성.
    """
    from unicodedata import normalize
    import re

    if not filename:
        # 파일명에서 한글 및 특수문자 제거 (ASCII만 남김)
        now = datetime.now()
        slug = (
            normalize("NFKD", title)
            .encode("ascii", "ignore")
            .decode("ascii")
        )
        slug = re.sub(r"[^\w\s-]", "", slug).strip().lower()
        slug = re.sub(r"[-\s]+", "-", slug)
        
        timestamp = now.strftime("%Y%m%d_%H%M%S")
        filename = f"{timestamp}_{slug[:50]}.json"
    
    blog_folder = ""
    for key, cfg in BLOGS.items():
        if cfg["name"] == blog_config["name"]:
            blog_folder = key
            break
            
    if not blog_folder:
        logger.warning(f"config.py에서 '{blog_config['name']}'에 해당하는 블로그 키를 찾지 못했습니다. drafts/ 루트에 저장합니다.")
        
    # [수정] 올바른 drafts 하위 폴더 경로 생성
    drafts_dir = os.path.join(os.path.dirname(__file__), "drafts", blog_folder)
    os.makedirs(drafts_dir, exist_ok=True)
    
    # [수정] 최종 파일 경로
    filepath = os.path.join(drafts_dir, filename)

    post_data = {
        "title": title,
        "content_html": content_html,
        "tags": tags,
        "category": category,
        "sections": sections or [],
        "blog": blog_config.get("name", ""),
        "created_at": datetime.now().isoformat(),
        "posted": False,
    }

    try:
        with open(filepath, "w", encoding="utf-8") as f:
            json.dump(post_data, f, ensure_ascii=False, indent=2)
        logger.info(f"임시 저장: {filepath}")
        return filepath
    except Exception as e:
        logger.error(f"'{filepath}' 저장 실패: {e}")
        return None


# [수정] main 함수에서 실패 시 sys.exit(1) 호출
if __name__ == "__main__":
    import argparse
    from config import BLOGS

    parser = argparse.ArgumentParser(description="네이버 블로그 포스팅 스크립트")
    parser.add_argument("--draft_path", required=True, help="포스팅할 JSON 파일 경로")
    args = parser.parse_args()

    logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

    try:
        with open(args.draft_path, "r", encoding="utf-8") as f:
            draft = json.load(f)
    except FileNotFoundError:
        logger.error(f"오류: 파일을 찾을 수 없습니다 - {args.draft_path}")
        sys.exit(1)
    except json.JSONDecodeError:
        logger.error(f"오류: JSON 형식이 올바르지 않습니다 - {args.draft_path}")
        sys.exit(1)

    blog_name = draft.get("blog")
    if not blog_name:
        logger.error(f"오류: draft 파일 '{args.draft_path}'에 'blog' 키가 정의되지 않았습니다.")
        sys.exit(1)

    blog_config = None
    for config in BLOGS.values():
        if config.get("name") == blog_name:
            blog_config = config
            break

    if not blog_config:
        logger.error(f"오류: config.py에 '{blog_name}' 블로그 설정이 없습니다.")
        sys.exit(1)
    
    # 필수 필드 확인
    required_fields = ["title", "content_html", "tags"]
    if not all(field in draft for field in required_fields):
        missing = [field for field in required_fields if field not in draft]
        logger.error(f"오류: JSON 파일에 필수 필드가 누락되었습니다 - {', '.join(missing)}")
        sys.exit(1)

    # 포스팅 실행
    success = asyncio.run(post_to_naver_blog(
        title=draft["title"],
        content_html=draft["content_html"],
        tags=draft["tags"],
        category=draft.get("category", "일상·생각"),
        blog_config=blog_config
    ))

    # [수정] 결과에 따라 exit code 분기
    if success:
        logger.info("✅ 포스팅 성공!")
        # 성공 시 로컬 파일 삭제 또는 'posted: true'로 업데이트
        draft['posted'] = True
        with open(args.draft_path, "w", encoding="utf-8") as f:
            json.dump(draft, f, ensure_ascii=False, indent=2)
        sys.exit(0)
    else:
        logger.error("❌ 포스팅 실패.")
        sys.exit(1)
