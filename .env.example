# ==========================================
# 네이버 블로그 자동 포스팅 시스템 설정
# 이 파일을 복사해서 .env 로 저장 후 값을 입력하세요
# cp .env.example .env
# ==========================================

# Claude AI API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 네이버 계정
NAVER_ID=your_naver_id
NAVER_PW=your_naver_password

# 네이버 블로그 ID (블로그 주소에서 확인: blog.naver.com/[블로그ID])
NAVER_BLOG_ID=your_blog_id

# Unsplash 무료 이미지 API (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Pexels 무료 이미지 API (https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key

# 하루 포스팅 수 (기본값: 10)
POSTS_PER_DAY=7

# 포스팅 시작 시간 (기본값: 09:00, 24시간 형식)
POST_START_HOUR=9

# 브라우저 헤드리스 모드 (true: 화면 없이 실행, false: 화면 보이게 실행)
HEADLESS=true

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
