    draft = {
        "title": title,
        "content_html": content_html,
        "tags": tags,
        "category": category,
        "blog": blog_config.get("name", ""),
        "created_at": datetime.now().isoformat(),
        "posted": False,
    }
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(draft, f, ensure_ascii=False, indent=2)

    logger.info(f"?꾩떆 ??? {filename}")
    return filename
