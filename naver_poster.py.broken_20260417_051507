async def _enter_title(page, title):
    """?쒕ぉ ?낅젰 - SmartEditor ONE
    ?듭떖: Playwright???ㅼ젣 click()?쇰줈 ?ъ빱?ㅻ? 以 ??keyboard.type() ?ъ슜.
    execCommand留뚯쑝濡쒕뒗 React ?대? ?곹깭媛 媛깆떊?섏? ?딆븘 諛쒗뻾 ???쒕ぉ??鍮꾩뼱踰꾨┝.
    """
    main_frame = page.frame(name="mainFrame")
    if not main_frame:
        logger.warning("?쒕ぉ ?낅젰 ?ㅽ뙣: mainFrame ?놁쓬")
        return

    await page.wait_for_timeout(1000)

    # ?쒕ぉ ?곸뿭 selector ?곗꽑?쒖쐞 (SmartEditor ONE)
    selectors = [
        '.se-title-text',
        '.se-title-input',
        'div[contenteditable="true"][class*="title"]',
        'div[contenteditable="true"][aria-multiline="false"]',
        'div[contenteditable="true"][data-placeholder]',
    ]

    for sel in selectors:
        try:
            locator = main_frame.locator(sel).first
            if await locator.count() == 0:
                continue
            # Playwright ?ㅼ젣 ?대┃ ???ъ빱??            await locator.click()
            await page.wait_for_timeout(400)
            # ?꾩껜 ?좏깮 ????댄븨 (keyboard.type? React ?대깽???뺤긽 ?몃━嫄?
            await page.keyboard.press("Control+a")
            await page.keyboard.type(title, delay=40)
            await page.wait_for_timeout(300)
            logger.info(f"?쒕ぉ ?낅젰 ?꾨즺: {title[:30]} (selector: {sel})")
            return
        except Exception as e:
            logger.debug(f"?쒕ぉ selector ?쒕룄 ?ㅽ뙣 ({sel}): {e}")
            continue

    # 理쒗썑 ?대갚: JS濡?泥?踰덉㎏ contenteditable ?붿냼瑜?吏곸젒 click/focus ??keyboard.type
    try:
        result = await main_frame.evaluate("""
            () => {
                var all = Array.from(document.querySelectorAll('[contenteditable="true"]'));
                var el = all.find(function(e) { return e.tagName !== 'BODY'; });
                if (!el) {
                    var debug = Array.from(document.querySelectorAll('[contenteditable]'))
                        .map(function(e) { return e.tagName + '.' + (e.className||'').substring(0,30); }).join('|');
                    return 'not_found:' + debug;
                }
                // Frame?먮뒗 .mouse媛 ?놁쑝誘濡?JS濡?吏곸젒 click/focus
                el.click();
                el.focus();
                return 'ok:' + el.className.substring(0, 40);
            }
        """)
        if result and result.startswith('ok:'):
            await page.wait_for_timeout(300)
            await page.keyboard.press("Control+a")
            await page.keyboard.type(title, delay=40)
            logger.info(f"?쒕ぉ ?낅젰 ?꾨즺 (JS click ?대갚): {title[:30]} {result}")
        else:
            logger.warning(f"?쒕ぉ ?낅젰 ?ㅽ뙣: {result}")
    except Exception as e:
        logger.warning(f"?쒕ぉ ?낅젰 ?대갚 ?ㅽ뙣: {e}")


